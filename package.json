{
  "name": "the-paddle-club-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo for The Paddle Club Agra: Marketing Web, Customer PWA, Admin Panel, and WhatsApp Backend.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
